{
  "name": "vue-privacy-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:manual": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/packageElectronDir.ps1",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "generate:sa": "node scripts/generateSAFile.mjs",
    "test:tsp": "node scripts/testTspUnifiedBudget.mjs"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.privacy.ldp.demo",
    "productName": "隐私保护数据采集与聚合演示系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
